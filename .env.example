# Translation-layer runtime configuration.
# Copy to .env (gitignored) for local docker-compose runs; for K8s use
# the ConfigMap + Secret in deploy/k8s/.

# --- State store (required) --------------------------------------------------
STATE_STORE_DSN=postgres://translation:translation@localhost:5432/translation_state?sslmode=disable

# --- FROST target(s) ---------------------------------------------------------
# Comma-separated list. First entry = primary (fallback FROST during testbed).
# Append the central FROST URL when Topic #1 is live (F6 dual-write).
# Brabantse Delta (WBD) testbed server:
#   FROST_TARGETS=https://sta.wbd-rd.nl/FROST-Server/v1.1
FROST_TARGETS=http://localhost:8081/FROST-Server/v1.1
# FROST write credential. FROST-Server accepts Basic OR Bearer; one credential
# applies to every target in v1. Basic Auth wins when FROST_BASIC_AUTH_USER is
# set; otherwise FROST_WRITE_TOKEN is sent as a Bearer token.
FROST_WRITE_TOKEN=
# WBD uses Basic Auth (username "write"; set the password out-of-band):
FROST_BASIC_AUTH_USER=
FROST_BASIC_AUTH_PASSWORD=
# Disable TLS cert verification for FROST + MQTT. TESTBED ONLY — needed for a
# server with a self-signed / hostname-mismatched cert (e.g. WBD). Never true
# in production.
FROST_TLS_INSECURE_SKIP_VERIFY=false
# Per-request timeout for FROST HTTP calls (upsert probes + observation POSTs).
# Raise it on high-latency network paths (e.g. behind an intercepting proxy).
FROST_HTTP_TIMEOUT_SECONDS=15

# --- FROST MQTT write path (optional) ----------------------------------------
# When enabled, Observation creates are published over MQTT instead of HTTP
# POST; entity upserts and the idempotency probe still use HTTP. Auth reuses
# the FROST Basic credential above. Leave disabled to write purely over HTTP.
#   MQTT_ENABLED=true
#   MQTT_BROKER_URL=wss://sta.wbd-rd.nl/mqtt
MQTT_ENABLED=false
MQTT_BROKER_URL=
MQTT_TOPIC_PREFIX=v1.1
MQTT_QOS=1

# --- SULO adapter (REEN CMS REST API v3) -------------------------------------
# SULO's sensors are served by the REEN API: https://api.reen.com/guide/
# Auth is username/password (the same web-UI login) exchanged for a session
# token via POST /session — there is no static API key, so rotate the
# password rather than a key. Base URL, username and password must be set
# together; leave all three empty to run without the SULO adapter.
# The "/api/3" suffix is optional and appended when absent.
SULO_API_BASE_URL=https://api.reen.com/api/3
SULO_API_USERNAME=
SULO_API_PASSWORD=
# Only needed when the REEN account spans several customer accounts and the
# target is not its own (sent as the X-Customer header).
SULO_CUSTOMER_ID=

# SULO tuning — all optional; omit to use the adapter defaults.
# SULO_HTTP_TIMEOUT_SECONDS=30
# Instances per paged REEN request (REEN defaults to 100, hard cap 30000).
# SULO_PAGE_SIZE=500
# Fill-level rows pulled per container slot per poll cycle.
# SULO_OBSERVATION_PAGE_LIMIT=1000
# REEN analytics confidence floor. REEN uses 0 for a reading it judged
# erroneous, 60 for "no measurement" (interpolated), 80 for a reading inside
# the sensor's minimum measurable distance, 100 for normal smoothing.
# Default 1 drops only the erroneous ones; raise to 80 to accept measured
# values only.
# SULO_MIN_CONFIDENCE=1
# Per-Datastream freshness expectation (ADR-008). Unset falls back to the
# global FRESHNESS_THRESHOLD_HOURS. REEN estimate rates vary per customer,
# so set this to the observed cadence for your deployment.
# SULO_EXPECTED_CADENCE_SECONDS=14400

# --- Polling and validation --------------------------------------------------
POLL_INTERVAL_SECONDS=900
FRESHNESS_THRESHOLD_HOURS=6
CURSOR_INIT_LOOKBACK_SECONDS=3600
CLOCK_SKEW_TOLERANCE_SECONDS=300
STATE_STORE_RETENTION_DAYS=90

# --- Observability -----------------------------------------------------------
FRESHNESS_ALERT_WEBHOOK_URL=
LOG_LEVEL=INFO

# --- HTTP --------------------------------------------------------------------
# Cluster-internal admin listener (/healthz, /healthz/freshness, /metrics).
HTTP_ADDR=:8080

# --- Push ingestion (ADR-011) ------------------------------------------------
# Public, Ingress-exposed listener for POST /ingest/{vendorID}, used only by
# push-mode adapters. Leave empty to disable the push server (SULO is poll
# mode, so the MVP leaves this unset). MUST differ from HTTP_ADDR.
PUSH_HTTP_ADDR=
# Per-vendor push secret(s) are read by each push adapter, e.g.:
# ACME_PUSH_HMAC_SECRET=

# --- Collaborall replication (push decoder) ----------------------------------
# Shared secret the collaborall push adapter requires on POST /ingest/collaborall
# (sent by the standalone cmd/collaborall-reader as a Bearer token). Setting it
# registers the decoder; PUSH_HTTP_ADDR must also be set for the endpoint to serve.
COLLABORALL_INGEST_SECRET=
# Prefix prepended to every FROST entity name this layer creates. Marks our data
# in a FROST-Server shared with other parties and avoids name-based upsert
# collisions. Set for the Collaborall run; leave empty otherwise.
ENTITY_NAME_PREFIX=CF_

# --- Dummy adapter (end-to-end validation only) ------------------------------
# Registers a synthetic poll adapter that emits fake fill-level data so the
# whole pipeline can be validated before SULO is connected. NEVER enable in
# production.
DUMMY_ADAPTER_ENABLED=false
DUMMY_THINGS_COUNT=5
DUMMY_CADENCE_SECONDS=300
